;
; PIO PWM — ~20 kHz output, non-blocking duty update via TX FIFO.
;
; ISR must be preloaded with PIO_PWM_WRAP (2082) before enabling the SM.
;
; TX FIFO input: duty threshold (x register).
; The pin drives HIGH from the first count where y==x until y reaches 0.
; Higher threshold = pin goes HIGH sooner = more ON time.
;   PIO_PWM_WRAP+1 → y never matches → full OFF (0 %)
;   0              → matches only on the last tick → ~0.05 % ON
;   PIO_PWM_WRAP   → matches on the first tick → ~100 % ON
;
; Period = 3 (setup) + 3×(PIO_PWM_WRAP+1) = 6252 cycles @125 MHz → 19993 Hz ≈ 20 kHz
;
.program pio_pwm
.side_set 1 opt

    pull noblock    side 0   ; load new duty (keep last if empty); drive LOW
    mov x, osr               ; x = duty threshold
    mov y, isr               ; y = period countdown (PIO_PWM_WRAP)
countloop:
    jmp x!=y noset           ; if counter != threshold, stay LOW
    jmp skip        side 1   ; at threshold: drive HIGH for remainder of period
noset:
    nop                      ; cycle balance — 3 cycles per iteration either path
skip:
    jmp y-- countloop        ; decrement period, loop
