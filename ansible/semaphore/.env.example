# Copy to .env (gitignored) and fill in real values, then: docker compose up -d

# Login for the Semaphore web UI.
SEMAPHORE_ADMIN_USERNAME=admin
SEMAPHORE_ADMIN_PASSWORD=change-me
SEMAPHORE_ADMIN_EMAIL=admin@localhost

# Encrypts SSH keys/credentials Semaphore stores in its database. Generate with:
#   head -c32 /dev/urandom | base64
SEMAPHORE_ACCESS_KEY_ENCRYPTION=
