# syntax=docker/dockerfile:1
#
# Pinned (not :latest) so an upstream release doesn't silently invalidate
# every layer below and force a full rebuild. Bump deliberately.
FROM codercom/code-server:4.141.0

USER root

# Install Python, pip, and gosu (for privilege drop in entrypoint).
# Cache mounts keep apt downloads between builds (see docker/Dockerfile).
RUN rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache
RUN --mount=type=cache,id=apt-cache-code-server,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-code-server,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip gosu

# Install only the dependencies listed in pyproject.toml — not the redwing source itself.
# A minimal stub satisfies pip's package requirements so it can resolve and install
# all deps (numpy, opencv, pyzmq) without needing the real source tree.
# This layer is cached until pyproject.toml dependency specs change.
# The real source is provided at runtime via the /opt/redwing volume mount.
COPY pyproject.toml /tmp/redwing_build/
RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir -p /tmp/redwing_build/redwing \
    && touch /tmp/redwing_build/redwing/__init__.py \
    && pip3 install --break-system-packages /tmp/redwing_build \
    && rm -rf /tmp/redwing_build

# Point Python at the live volume mount so source changes take effect without rebuilding.
ENV PYTHONPATH=/opt/redwing

RUN mkdir -p /home/coder/.local/share/code-server/User \
    && chown -R coder:coder /home/coder/.local

USER coder
RUN code-server --install-extension ms-python.python
USER root
COPY --chown=coder:coder docker/code-server-settings.json \
    /home/coder/.local/share/code-server/User/settings.json

COPY docker/entrypoint-code-server.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
