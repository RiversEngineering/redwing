# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
/build/
.venv/
venv/
*.egg

# Pico firmware build — CMake's work directory (CMakeCache.txt, Makefile, etc.
# embed absolute paths from the machine that built them and are fully
# regenerated by firmware/build.sh) is ignored, but the actual build outputs
# are tracked for debugging (redwing.uf2 is also copied to firmware/redwing.uf2
# — see README).
firmware/build/*
!firmware/build/redwing.elf
!firmware/build/redwing.elf.map
!firmware/build/redwing.bin
!firmware/build/redwing.hex
!firmware/build/redwing.dis

# Same treatment for the bno085_test scratch project's build directory —
# this one also vendors a from-source picotool build, so it's much bigger.
firmware/bno085_test/build/*
!firmware/bno085_test/build/bno085_test.elf
!firmware/bno085_test/build/bno085_test.elf.map
!firmware/bno085_test/build/bno085_test.bin
!firmware/bno085_test/build/bno085_test.hex
!firmware/bno085_test/build/bno085_test.dis
!firmware/bno085_test/build/bno085_test.uf2

# Dashboard build
dashboard/node_modules/
dashboard/dist/

# macOS
.DS_Store

# VS Code
.vscode/settings.json

# Secrets / env
.env
*.local
