# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
/build/
.venv/
venv/
*.egg

# Pico firmware build — CMake's work directory (CMakeCache.txt, Makefile, etc.
# embed absolute paths from the machine that built them and are fully
# regenerated by firmware/build.sh) is ignored, but the actual build outputs
# are tracked for debugging (redwing.uf2 is also copied to firmware/redwing.uf2
# — see README).
firmware/build/*
!firmware/build/redwing.elf
!firmware/build/redwing.elf.map
!firmware/build/redwing.bin
!firmware/build/redwing.hex
!firmware/build/redwing.dis

# Dashboard build
dashboard/node_modules/
dashboard/dist/

# macOS
.DS_Store

# VS Code
.vscode/settings.json

# Secrets / env
.env
*.local
